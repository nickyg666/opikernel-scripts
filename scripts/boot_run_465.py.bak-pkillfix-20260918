#!/usr/bin/env python3
"""boot_run_465.py — Use boot.scr.465-fixed as actual boot.scr by overwriting SD boot.scr.
Steps:
1. Load boot.scr.465-fixed into RAM
2. ext4write it to /boot/boot.scr
3. Boot from there with aic8800 blacklist added
Usage: sudo python3 boot_run_465.py
"""
import serial, sys, time, os, subprocess

DEV = "/dev/ttyACM0"
BAUD = 115200
LOG = "/home/host/pvrgl-work/boot_run_465.log"

logf = open(LOG, 'wb', buffering=0)
def log(msg):
    ts = time.strftime('%H:%M:%S')
    line = f"[{ts}] {msg}\n"
    sys.stdout.write(line); sys.stdout.flush()
    logf.write(line.encode('utf-8')); logf.flush()

def drain(ser):
    for _ in range(20):
        if ser.in_waiting:
            ser.read(ser.in_waiting)
        time.sleep(0.1)

def send_cmd(ser, cmd, wait=3.0):
    ser.write(cmd.encode() + b'\r')
    time.sleep(0.1)
    out = b''
    deadline = time.time() + wait
    while time.time() < deadline:
        if ser.in_waiting:
            out += ser.read(ser.in_waiting)
        time.sleep(0.05)
    return out.decode('utf-8', errors='replace')

def wait_for(ser, patterns, timeout=30):
    start = time.time()
    buf = b''
    while time.time() - start < timeout:
        if ser.in_waiting:
            data = ser.read(ser.in_waiting)
            buf += data
            decoded = buf.decode('utf-8', errors='replace')
            for p in patterns:
                if p in decoded:
                    return p, decoded
        time.sleep(0.05)
    return None, buf.decode('utf-8', errors='replace')

log("Killing readers...")
subprocess.run("pkill -9 -f 'cat /dev/ttyACM0' 2>/dev/null; sleep 1", shell=True)
time.sleep(2)

log("Opening serial...")
ser = serial.Serial(DEV, BAUD, timeout=1)
ser.dtr = False; ser.rts = False
time.sleep(0.5)
drain(ser)

log("Power cycle...")
subprocess.run(["/usr/bin/python3","/home/host/opikernel/scripts/host/smartplug.py","off","--model","WLPP1CFH","D03F271583AE"], capture_output=True)
time.sleep(5)
subprocess.run(["/usr/bin/python3","/home/host/opikernel/scripts/host/smartplug.py","on","--model","WLPP1CFH","D03F271583AE"], capture_output=True)

log("Waiting for U-Boot...")
pat, _ = wait_for(ser, ['Hit any key', '=>'], timeout=30)
if not pat:
    log("FAILED: No prompt"); logf.close(); ser.close(); sys.exit(1)
log(f"Found '{pat}' — break...")
ser.break_condition = True; time.sleep(0.05); ser.break_condition = False
time.sleep(0.3); ser.write(b'\r'); time.sleep(1.0)
drain(ser); time.sleep(2)

# Step 1: Load boot.scr.465-fixed into RAM
log("Loading boot.scr.465-fixed into RAM...")
resp = send_cmd(ser, "ext4load mmc 0:1 0x43200000 /boot/boot.scr.465-fixed", 10)
log(f"Loaded: {resp.strip()[:100]}")
# Check for success
if "bytes read" not in resp:
    log("LOAD FAILED"); logf.close(); ser.close(); sys.exit(1)
size = 6350  # known

# Step 2: Write to /boot/boot.scr
log(f"Writing 6350 bytes to /boot/boot.scr...")
# ext4write needs device, partition, addr, filename, offset, size
resp = send_cmd(ser, f"ext4write mmc 0:1 0x43200000 /boot/boot.scr 0 {size}", 15)
log(f"ext4write: {resp.strip()[:200]}")

# Step 3: Set bootargs to add aic8800 blacklist
log("Setting bootargs with aic8800 blacklist...")
A = "console=ttyS0,115200 root=/dev/mmcblk1p1 rootwait rootfstype=ext4 modprobe.blacklist=aic8800_sdio,aic8800_bt loglevel=7 clk_ignore_unused earlyprintk=sunxi-uart,0x02500000 earlycon=uart,mmio32,0x2500000"
send_cmd(ser, f"setenv bootargs {A}", 3)

# Step 4: Boot from boot.scr
log("=== BOOTING from boot.scr ===")
ser.write(b'boot\r')
time.sleep(3); drain(ser)

# Watch boot
log("Watching (120s)...")
boot_start = time.time()
userspace = False
while time.time() - boot_start < 120:
    if ser.in_waiting:
        data = ser.read(ser.in_waiting)
        decoded = data.decode('utf-8', errors='replace')
        logf.write(decoded.encode('utf-8', errors='replace')); logf.flush()
        if 'login:' in decoded:
            userspace = True; log("*** USERSAPCE ***"); break
        if 'Kernel panic' in decoded:
            log("*** PANIC ***"); break
    time.sleep(0.05)

logf.close(); ser.close()
time.sleep(5)
ssh_ok = subprocess.run(["ping","-c","3","-W","2","192.168.0.151"], capture_output=True).returncode == 0
log(f"\nRESULT: SSH={ssh_ok} userspace={userspace}")
log(f"Log: {LOG} ({os.path.getsize(LOG)} bytes)")
