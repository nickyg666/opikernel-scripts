#!/bin/bash
# Agent watchdog — resumes stalled gc sessions every 2 minutes
# Runs as cron: */2 * * * * /home/host/opikernel/scripts/agent-watchdog.sh
# Sessions are DB-backed (state.db), not filesystem dirs — query sqlite directly.
export PATH="/home/host/.local/bin:$PATH"
LOG=/home/host/opikernel/logs/agent-watchdog.log
STATE=/home/host/opikernel/scripts/agent-watchdog-state.json
STALE_MIN=8  # resume if no activity in 8 minutes
GAP_MIN=5    # don't re-nudge same session within 5 min
DB=/home/host/.hermes/state.db

mkdir -p "$(dirname "$LOG")"
mkdir -p "$(dirname "$STATE")"
cd /home/host || exit 0

# Flock to prevent concurrent watchdog runs stacking up hermes chat processes
LOCK=/home/host/opikernel/scripts/agent-watchdog.lock
exec 9>"$LOCK"
if ! flock -n 9; then
    echo "[$(date)] another watchdog instance already running; exiting" >> "$LOG"
    exit 0
fi

# Load last-nudge state
if [ -f "$STATE" ]; then
    LAST_NUDGE=$(cat "$STATE" 2>/dev/null)
    # validate JSON
    echo "$LAST_NUDGE" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null || LAST_NUDGE="{}"
else
    LAST_NUDGE="{}"
fi
if [ -z "$LAST_NUDGE" ]; then LAST_NUDGE="{}"; fi

NOW=$(date +%s)
STALE_SEC=$(( STALE_MIN * 60 ))

# Query DB for stale gc sessions (not ended, age >= STALE_MIN, last role = user)
# Uses messages table for last activity; sessions.ended_at IS NULL = still open
# Filter last_role='user' IN SQL — LIMIT 20 with ORDER BY DESC on timestamp
# previously surfaced only the 20 most-recently-active stale sessions, which were
# all assistant-role (agents mid-turn). User-role sessions waiting for a reply
# ranked below the cutoff and were never reached. No LIMIT now.
STALE_SIDS=$(timeout 60 sqlite3 "$DB" "
SELECT m.session_id
FROM messages m
JOIN sessions s ON s.id = m.session_id
WHERE m.session_id LIKE 'gc_%'
  AND s.ended_at IS NULL
  AND (
    SELECT role FROM messages m2
    WHERE m2.session_id = m.session_id
    ORDER BY m2.timestamp DESC LIMIT 1
  ) = 'user'
GROUP BY m.session_id
HAVING ($NOW - max(m.timestamp)) >= $STALE_SEC
ORDER BY max(m.timestamp) DESC;
" 2>/dev/null)

if [ -z "$STALE_SIDS" ]; then
    exit 0
fi

# Hard cap: don't launch more hermes chat processes if we're already saturated
# (prevents runaway when a previous run is still mid-nudge)
MAX_CONCURRENT=3
MAX_NUDGE=5
RUNNING=$(pgrep -c -f 'hermes chat' 2>/dev/null || echo 0)
if [ "$RUNNING" -ge "$MAX_CONCURRENT" ]; then
    echo "[$(date)] $RUNNING hermes chat processes already running (cap $MAX_CONCURRENT); skipping" >> "$LOG"
    exit 0
fi

# Convert to array (avoid pipe-subshell so sleep actually serializes)
IFS=$'\n' read -r -d '' -a SID_ARRAY <<< "$STALE_SIDS"
NUDGED=0

for sid in "${SID_ARRAY[@]}"; do
    [ -z "$sid" ] && continue
    [ "$NUDGED" -ge "$MAX_NUDGE" ] && break
    # Check last message role — only nudge if agent is expected to reply (last = user)
    last_role=$(sqlite3 "$DB" "SELECT role FROM messages WHERE session_id='$sid' ORDER BY timestamp DESC LIMIT 1;" 2>/dev/null)
    if [ "$last_role" != "user" ]; then
        continue
    fi
    last_ts=$(sqlite3 "$DB" "SELECT max(timestamp) FROM messages WHERE session_id='$sid';" 2>/dev/null)
    # sqlite returns float; truncate
    last_ts_int=$(printf "%.0f" "$last_ts" 2>/dev/null || echo "0")
    age_min=$(( (NOW - last_ts_int) / 60 ))

    # Check GAP_MIN via STATE file (re-read each iteration to handle concurrent updates)
    if [ -f "$STATE" ]; then
        LAST_NUDGE=$(cat "$STATE" 2>/dev/null || echo "{}")
    fi
    last_nudged=$(echo "$LAST_NUDGE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('$sid',0))" 2>/dev/null || echo "0")
    # handle float
    last_nudged_int=$(printf "%.0f" "$last_nudged" 2>/dev/null || echo "0")
    nudge_gap=$(( (NOW - last_nudged_int) / 60 ))

    if [ "$age_min" -ge "$STALE_MIN" ] && [ "$nudge_gap" -ge "$GAP_MIN" ]; then
        echo "[$(date)] Resuming stale session $sid (${age_min}m old, last_role=$last_role)" >> "$LOG"
        hermes chat -Q -r "$sid" -m freecode -q "Continue." >> "$LOG" 2>&1 &
        # Update nudge time atomically — re-read, merge, write
        if [ -f "$STATE" ]; then
            CUR=$(cat "$STATE" 2>/dev/null || echo "{}")
        else
            CUR="{}"
        fi
        echo "$CUR" | python3 -c "import sys,json; d=json.load(sys.stdin); d['$sid']=$NOW; print(json.dumps(d))" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"
        # Small delay to avoid hammering admission
        sleep 1
    fi
done
