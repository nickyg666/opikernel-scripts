#!/usr/bin/env python3
"""uboot_list_files.py — List ALL files in /boot/ and subdirs via ext4findfiles.
Usage: sudo python3 uboot_list_files.py
"""
import serial, sys, time, os, signal, subprocess

DEV = "/dev/ttyACM0"
BAUD = 115200
LOG = "/home/host/pvrgl-work/uboot_list_files.log"

logf = open(LOG, 'w', buffering=1)
def log(msg):
    ts = time.strftime('%H:%M:%S')
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    logf.write(line + "\n"); logf.flush()

def signal_handler(sig, frame):
    log("[INTERRUPTED]"); logf.close(); sys.exit(0)
signal.signal(signal.SIGINT, signal_handler)

def drain(ser):
    total = 0
    for _ in range(20):
        if ser.in_waiting:
            n = ser.in_waiting
            ser.read(n); total += n
            time.sleep(0.1)
        else:
            time.sleep(0.2)
    return total

def send_cmd(ser, cmd, wait=2.0):
    log(f">>> {cmd[:90]}")
    ser.write(cmd.encode() + b'\r')
    time.sleep(0.1)
    out = b''
    deadline = time.time() + wait
    while time.time() < deadline:
        if ser.in_waiting:
            out += ser.read(ser.in_waiting)
        time.sleep(0.05)
    resp = out.decode('utf-8', errors='replace')
    for line in resp.split('\r'):
        line = line.strip()
        if line and '=>' not in line:
            log(f"    {line}")
    return resp

def wait_for(ser, patterns, timeout=30):
    start = time.time()
    buf = b''
    while time.time() - start < timeout:
        if ser.in_waiting:
            data = ser.read(ser.in_waiting)
            buf += data
            decoded = buf.decode('utf-8', errors='replace')
            for p in patterns:
                if p in decoded:
                    return p, decoded
        time.sleep(0.05)
    return None, buf.decode('utf-8', errors='replace')

# KILL & OPEN
log("Killing existing readers...")
subprocess.run("pkill -9 -f 'cat /dev/ttyACM0' 2>/dev/null; sleep 1", shell=True)
time.sleep(2)
log("Opening serial...")
ser = serial.Serial(DEV, BAUD, timeout=1)
ser.dtr = False; ser.rts = False
time.sleep(0.5)
drained = drain(ser)
log(f"Drained {drained} stale bytes")

# POWER CYCLE
log("Power cycle...")
subprocess.run(["/usr/bin/python3","/home/host/opikernel/scripts/host/smartplug.py","off","--model","WLPP1CFH","D03F271583AE"], capture_output=True)
time.sleep(5)
subprocess.run(["/usr/bin/python3","/home/host/opikernel/scripts/host/smartplug.py","on","--model","WLPP1CFH","D03F271583AE"], capture_output=True)

# WAIT FOR U-BOOT
log("Waiting for U-Boot...")
pat, data = wait_for(ser, ['Hit any key', '=>'], timeout=30)
if not pat:
    log(f"FAILED: No prompt"); logf.close(); ser.close(); sys.exit(1)
log(f"Found '{pat}' — sending break...")
ser.break_condition = True; time.sleep(0.05); ser.break_condition = False
time.sleep(0.3); ser.write(b'\r'); time.sleep(1.0)
drain(ser); time.sleep(2)
log("U-Boot shell ready.")

# ext4findfiles - list all files recursively
for path in ["/boot", "/boot/mainline", "/"]:
    log(f"\n=== ext4findfiles {path} ===")
    resp = send_cmd(ser, f"ext4findfiles mmc 0:1 {path}", 15)
    time.sleep(1)

# Also do ext4ls for directories
for path in ["/boot", "/boot/mainline"]:
    log(f"\n=== ext4ls {path} ===")
    resp = send_cmd(ser, f"ext4ls mmc 0:1 {path}", 10)
    time.sleep(1)

logf.close(); ser.close()
log(f"\nLog: {LOG} ({os.path.getsize(LOG)} bytes)")
